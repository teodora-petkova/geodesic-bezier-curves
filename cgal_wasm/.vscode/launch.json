{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Geodesic Test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test_geodesics",
            "args": ["-g"], //["--gtest_filter="],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "make build"
        }
    ]
}